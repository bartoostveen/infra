From 943edfd910f24fa3730f29712339b7e8030c7c9f Mon Sep 17 00:00:00 2001
From: Bart Oostveen <bart@bartoostveen.nl>
Date: Thu, 20 Aug 2026 15:21:16 +0200
Subject: [PATCH 2/3] wordpress: 7.0.4 -> 7.1

Announcement: https://wordpress.org/news/2026/08/mary-lou/
Release notes: https://wordpress.org/documentation/wordpress-version/version-7.1/
---
 nixos/tests/wordpress.nix                   | 1 +
 pkgs/servers/web-apps/wordpress/default.nix | 6 +++++-
 pkgs/top-level/all-packages.nix             | 1 +
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/nixos/tests/wordpress.nix b/nixos/tests/wordpress.nix
index 4ecc5c2b21b6..b0a7e69e8608 100644
--- a/nixos/tests/wordpress.nix
+++ b/nixos/tests/wordpress.nix
@@ -89,6 +89,7 @@ rec {
       [
         "6_9"
         "7_0"
+        "7_1"
       ];
 
   testScript = ''
diff --git a/pkgs/servers/web-apps/wordpress/default.nix b/pkgs/servers/web-apps/wordpress/default.nix
index dd5a80a7cb8b..397a823e5f57 100644
--- a/pkgs/servers/web-apps/wordpress/default.nix
+++ b/pkgs/servers/web-apps/wordpress/default.nix
@@ -1,6 +1,6 @@
 { callPackage }:
 builtins.mapAttrs (_: callPackage ./generic.nix) rec {
-  wordpress = wordpress_7_0;
+  wordpress = wordpress_7_1;
   wordpress_6_9 = {
     version = "6.9.7";
     hash = "sha256-Ef1l7Mv03V3l7LNyS1X5LFbWweqWdJf+k3S83XpvvaY=";
@@ -9,4 +9,8 @@ builtins.mapAttrs (_: callPackage ./generic.nix) rec {
     version = "7.0.4";
     hash = "sha256-Jrmav8ZUJ/urUrJDFVOblE3O8UZ4maUla2wd4sSufkY=";
   };
+  wordpress_7_1 = {
+    version = "7.1";
+    hash = "sha256-BaX4kTj2MrcynxIC8qBVPF9/5Nr45LnKfrrpuUZrnoY=";
+  };
 }
diff --git a/pkgs/top-level/all-packages.nix b/pkgs/top-level/all-packages.nix
index 24bfa4692e4d..a1add8c90906 100644
--- a/pkgs/top-level/all-packages.nix
+++ b/pkgs/top-level/all-packages.nix
@@ -10675,6 +10675,7 @@ with pkgs;
     wordpress
     wordpress_6_9
     wordpress_7_0
+    wordpress_7_1
     ;
 
   wordpressPackages = recurseIntoAttrs (
-- 
2.55.0

